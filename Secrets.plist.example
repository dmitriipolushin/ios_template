<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Copy this file as Secrets.plist into App/Resources/ and fill in your values.
	  Secrets.plist is gitignored — it will NOT be committed.

	  Usage in code:
	    Bundle.main.path(forResource: "Secrets", ofType: "plist")
	    or KeychainHelper for runtime secrets
	-->

	<!-- OpenAI API key (https://platform.openai.com/api-keys) -->
	<key>OPENAI_API_KEY</key>
	<string></string>

	<!-- Adapty public SDK key (Dashboard → App settings → General) -->
	<!-- NOTE: Also set in AdaptyManager.swift → AdaptyConfig.apiKey -->
	<key>ADAPTY_API_KEY</key>
	<string></string>

	<!-- kie.ai API key for /imagine skill (https://kie.ai) -->
	<!-- Set as KIE_API_KEY environment variable instead of plist -->
	<key>KIE_API_KEY</key>
	<string></string>

	<!-- Uncomment as needed: -->

	<!-- Firebase (GoogleService-Info.plist is a separate file) -->
	<!-- <key>FIREBASE_API_KEY</key> -->
	<!-- <string></string> -->

	<!-- Supabase -->
	<!-- <key>SUPABASE_URL</key> -->
	<!-- <string>https://your-project.supabase.co</string> -->
	<!-- <key>SUPABASE_ANON_KEY</key> -->
	<!-- <string></string> -->

	<!-- Amplitude -->
	<!-- <key>AMPLITUDE_API_KEY</key> -->
	<!-- <string></string> -->
</dict>
</plist>
